# Copy this file to .env.local and replace each placeholder.
# Never commit real credentials.

# Database and authentication
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>
JWT_SECRET=replace-with-a-long-random-secret

# Admin login configuration
ADMIN_USERNAME=replace-with-admin-username
ADMIN_PASSWORD=replace-with-a-strong-admin-password

# Server-side Cloudinary configuration
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# Browser-facing Cloudinary upload configuration.
# Use a restricted unsigned upload preset; these values are public in the client.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=your-restricted-upload-preset

# PayPal client configuration (use sandbox credentials while testing)
NEXT_PUBLIC_PAYPAL_CLIENT_ID=your-paypal-client-id

# Admin email notifications
ADMIN_NOTIFICATION_EMAIL=admin@example.com
CONTACT_EMAIL=sender@example.com
CONTACT_EMAIL_PASSWORD=your-email-app-password

# Google Sheets order export
GS_PROJECT_ID=your-google-cloud-project-id
GS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace-with-private-key-content\n-----END PRIVATE KEY-----\n"
GS_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GS_SHEET_ID=your-google-spreadsheet-id
